datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum CityTier {
  TIER_1
  TIER_2
  TIER_3
}

enum TransactionType {
  INCOME
  EXPENSE
}


enum GoalCategory {
  EMERGENCY_FUND
  VEHICLE
  HOUSE
  VACATION
  MARRIAGE
  EDUCATION
  RETIREMENT
  OTHER
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String?
  name             String
  role             Role            @default(USER)
  cityTier         CityTier        @default(TIER_2)
  monthlyIncome    Float           @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  salaryProfiles   SalaryProfile[]
  expenses         Expense[]
  goals            Goal[]
  assets           Asset[]
  liabilities      Liability[]
  chatSessions     ChatSession[]
  userProgress     UserProgress?
  incomes          Income[]
  expenseCategories ExpenseCategory[]
  taxonomyNodes     TaxonomyNode[]
  budgets           Budget[]
  aiBudgetDecisions AIBudgetDecision[]
  aiBudgetAuditLogs AIBudgetAuditLog[]
}

model SalaryProfile {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grossMonthly     Float
  basicSalary      Float
  hraReceived      Float
  specialAllowance Float
  regime           String   @default("NEW")
  needsPercent     Float    @default(50)
  wantsPercent     Float    @default(30)
  savingsPercent   Float    @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Expense {
  id                  String          @id @default(uuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  merchant            String?
  category            String
  subcategory         String?
  amount              Float
  currency            String          @default("INR")
  paymentMethod       String          @default("UPI")
  account             String?
  date                DateTime        @default(now())
  notes               String?
  tags                String[]
  receiptUrl          String?
  location            String?
  latitude            Float?
  longitude           Float?
  isRecurring         Boolean         @default(false)
  recurrenceFrequency String?
  status              String          @default("PAID")
  isDeleted           Boolean         @default(false)
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Goal {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  category          GoalCategory
  targetAmount      Float
  currentAmount     Float        @default(0)
  targetDate        DateTime
  monthlyAllocation Float        @default(0)
  isCompleted       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Asset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  value     Float
  updatedAt DateTime @updatedAt
}

model Liability {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  totalAmount  Float
  remaining    Float
  interestRate Float
  monthlyEmi   Float
  updatedAt    DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Financial Consultation")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String
  text      String
  createdAt DateTime    @default(now())
}

model UserProgress {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpPoints         Int      @default(0)
  completedQuizIds String[]
  badges           String[]
  updatedAt        DateTime @updatedAt
}

model Income {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome     Float
  annualIncome      Float
  salaryType        String    // e.g. Salary, Business, Freelancer, Student, Retired
  employmentType    String    // e.g. Private, Government, Self Employed, Business Owner, Contract, Other
  incomeFrequency   String    // e.g. Monthly, Quarterly, Yearly, Weekly
  cityCategory      String    // e.g. Metro, Tier1, Tier2, Tier3, Rural
  taxRegime         String    // e.g. Old, New
  bonusIncome       Float     @default(0)
  otherIncome       Float     @default(0)
  freelanceIncome   Float     @default(0)
  rentalIncome      Float     @default(0)
  investmentIncome  Float     @default(0)
  currency          String    @default("INR")
  financialPriority String[]
  riskProfile       String    // e.g. Conservative, Balanced, Aggressive
  isPrimaryIncome       Boolean   @default(true)
  notes                 String?
  totalAdditionalIncome Float     @default(0)
  totalIncome           Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete support

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model ExpenseCategory {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  icon             String
  color            String
  displayOrder     Int      @default(0)
  parentCategory   String?
  subcategories    String[]
  budgetEligible   Boolean  @default(true)
  analyticsEnabled Boolean  @default(true)
  aiEnabled        Boolean  @default(true)
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  userId           String?  // NULL for default system categories
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([slug])
}

model TaxonomyNode {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  type             String   // e.g. EXPENSE, INCOME, INVESTMENT, GOAL, ASSET, LIABILITY
  description      String?
  icon             String
  color            String
  displayOrder     Int      @default(0)
  parentId         String?
  subcategories    String[]
  budgetCategory   String?
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  userId           String?  // NULL for default system categories
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([type])
}

model Budget {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                Int
  year                 Int
  currency             String           @default("INR")
  totalBudget          Float
  remainingBudget      Float
  spentAmount          Float            @default(0)
  utilizationPercentage Float            @default(0)
  status               String           @default("SAFE") // SAFE, HEALTHY, WARNING, CRITICAL, EXCEEDED
  strategy             String           @default("MANUAL") // MANUAL, AUTO_50_30_20, AI_RECOMMENDED
  carryForward         Boolean          @default(false)
  notes                String?
  categoryBudgets      CategoryBudget[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
}

model CategoryBudget {
  id          String   @id @default(uuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId  String
  allocated   Float
  spent       Float    @default(0)
  remaining   Float
  percentage  Float    @default(0)
  status      String   @default("SAFE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([budgetId, categoryId])
  @@index([budgetId])
}

model AIBudgetDecision {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId  String
  action            String   // ACCEPTED, REJECTED, MODIFIED, DISMISSED
  categoryOverrides String   // JSON string of offset values
  createdAt         DateTime @default(now())

  @@index([userId])
}

model AIBudgetAuditLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId      String
  type            String   // e.g. BUDGET_REBALANCE, SALARY_ADJUST, EMERGENCY_FUND_UP
  previousState   String   // JSON string
  newState        String   // JSON string
  financialImpact Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
}
